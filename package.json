{
  "name": "helpdesk-express",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HelpDesk Express – suivi d'incidents IT en Event Sourcing (DDD, Clean Architecture, tRPC, React)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/infrastructure/server.ts",
    "dev:web": "vite",
    "start:api": "tsx src/infrastructure/server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/infrastructure/scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "lucide-react": "^1.72.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.1.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
